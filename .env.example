DATABASE_URL=postgres://user:pass@host:5432/db
# Provide a unique JWT secret via your deployment secret store; do not commit real secrets.
JWT_SECRET=<generate_me>
# Provide the Slack webhook via your deployment secret store; do not commit real webhook URLs.
SLACK_WEBHOOK=<set_in_secret_store>
APP_ENV=production
LOG_LEVEL=info
TENANT_HEADER=x-tenant-id
